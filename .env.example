DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techdaily
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash
# При 503/429 — повторные попытки и смена модели: по умолчанию gemini-flash-latest, GEMINI_MODEL или lite.
# Пауза (мс) между 3 шагами генерации урока в Gemini (меньше нагрузка на один ответ)
# GEMINI_LESSON_STEP_DELAY_MS=2500
JWT_SECRET=your-super-secret-key-change-in-production
ADMIN_EMAILS=admin@example.com
AI_PIPELINE_PREVIEW=true
# Ручной POST /api/ai-pipeline/curate-me и ночная курация используют Gemini
AI_MANUAL_CURATE=true
AI_AUTO_PUBLISH_CURATED_LESSONS=true

PORT=3000
NODE_ENV=development
